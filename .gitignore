# The relay's own data: a reading store, its WAL files and keys are never committed
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite-wal
*.sqlite-shm
/config.json
/config.toml

# Build output
/cgm-relay
/dist/
/bin/
*.test
*.out
coverage.*

# macOS menu bar app build artifacts (macos/) -- project.yml and the
# Swift sources are tracked; everything XcodeGen or Xcode itself
# generates from them is not.
/macos/*.xcodeproj/
/macos/.build/
/macos/Packages/CGMRelayCore/.build/
/macos/Packages/CGMRelayCore/.swiftpm/

# OS and editor files
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/
*.iml
.history/

# Logs and temporary files
*.log
*.tmp
*.temp
tmp/

